#!/bin/sh
# live-build configuration for the CraftOS spin (Debian 13 "trixie").
set -e

lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free-firmware" \
    --parent-archive-areas "main contrib non-free-firmware" \
    --linux-flavours amd64 \
    --binary-images iso-hybrid \
    --bootloaders "syslinux,grub-efi" \
    --debian-installer none \
    --apt-recommends false \
    --iso-application "CraftOS" \
    --iso-publisher "nu-stats" \
    --iso-volume "CraftOS" \
    --image-name craftos \
    --debootstrap-options "--include=ca-certificates,gnupg" \
    --bootappend-live "boot=live components quiet splash locales=en_US.UTF-8 keyboard-layouts=us" \
    "${@}"
