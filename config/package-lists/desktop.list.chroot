# Explicit, minimal GNOME desktop. Recommends are off (auto/config), so
# everything the session needs is listed here; no games, mail, calendar or
# office suite (the ArtCraft apps come in through craftos-desktop instead).

# Session and shell
gdm3
gnome-shell
gnome-session
gnome-settings-daemon
gnome-control-center
nautilus
gnome-terminal
gnome-text-editor
gnome-system-monitor
gnome-calculator
gnome-disk-utility
gnome-keyring
libpam-gnome-keyring
file-roller
xdg-desktop-portal-gnome
xdg-user-dirs-gtk
xdg-utils
gnome-menus
desktop-file-utils
dbus-user-session
gvfs
gvfs-backends
gvfs-fuse

# Software center
gnome-software
packagekit

# Browser
firefox-esr
zenity

# Zorin-style layout, theme, fonts
gnome-shell-extension-dash-to-panel
gnome-shell-extension-appindicator
gnome-shell-extension-arc-menu
# ArcMenu only Recommends this, but fails to load without it.
gir1.2-gmenu-3.0
gnome-shell-extension-desktop-icons-ng
# Quick-look previews for desktop icons (DING asks for it on Space).
gnome-sushi
# Not in Debian 12; packaged into the CraftOS repo by scripts/build-extension-debs.sh
gnome-shell-extension-blur-my-shell
arc-theme
papirus-icon-theme
adwaita-icon-theme
fonts-inter
fonts-noto-core
fonts-noto-color-emoji

# Graphics stack (the ArtCraft apps render with Vulkan or EGL)
xwayland
xserver-xorg-core
xserver-xorg-input-libinput
xserver-xorg-video-vesa
xserver-xorg-video-fbdev
xserver-xorg-video-vmware
libgl1-mesa-dri
libegl1
libvulkan1
mesa-vulkan-drivers
libxkbcommon0
libxkbcommon-x11-0

# Network, audio, power, privileges
network-manager
network-manager-gnome
wpasupplicant
pipewire
pipewire-pulse
wireplumber
power-profiles-daemon
polkitd
pkexec
sudo
firmware-linux

# Installer
calamares
calamares-settings-debian
# Calamares only Recommends these (or not at all), but unpackfs and the EFI
# partition step fail without them.
squashfs-tools
rsync
dosfstools

# Live session and boot splash. live-config only creates the live user and
# GDM autologin when its Recommends are present, and recommends are off, so
# they are listed explicitly.
live-boot
live-config
live-config-systemd
live-tools
user-setup
locales
keyboard-configuration
tzdata
plymouth

# Basics
bash-completion
nano
curl
wget
less
ca-certificates
