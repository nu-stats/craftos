#!/bin/sh
# Runs inside the image chroot at build time.
set -e

# /usr/lib/os-release (NAME="CraftOS", ID=debian) comes from craftos-desktop,
# which diverts base-files' copy so Debian updates do not undo it.
echo "CraftOS 0.1" > /etc/craftos-release
printf 'CraftOS 0.1 \\n \\l\n\n' > /etc/issue
printf 'CraftOS 0.1\n' > /etc/issue.net

# craftos-desktop's postinst does these two on installed systems; repeat them
# here because in the image's single apt run gdm3 may be configured after it.
# Compile dconf defaults (panel layout, theme, wallpaper, favourites).
dconf update

# Login screen. Debian's GDM reads only /etc/gdm3/greeter.dconf-defaults
# (compiled when gdm starts), not a system dconf db, so set the logo there.
sed -i 's#^logo=.*#logo='"'"'/usr/share/craftos/login-logo.png'"'"'#' /etc/gdm3/greeter.dconf-defaults

# No Debian swirl as everyone's account picture: drop desktop-base's default
# face so GNOME shows its neutral avatar until the user picks one.
rm -f /etc/skel/.face /etc/skel/.face.icon

# Boot splash.
plymouth-set-default-theme -R craftos

# Installer: show CraftOS instead of Debian. Only the name/label fields.
for d in /etc/calamares/branding/*/ /usr/share/calamares/branding/*/; do
    [ -f "${d}branding.desc" ] || continue
    sed -i -E \
        -e '/^[[:space:]]*(productName|shortProductName|bootloaderEntryName):/ s/Debian GNU\/Linux|Debian/CraftOS/g' \
        -e 's/^([[:space:]]*version:).*/\1             0.1 (Debian 12 based)/' \
        -e 's/^([[:space:]]*shortVersion:).*/\1        0.1/' \
        -e 's/^([[:space:]]*versionedName:).*/\1       CraftOS 0.1/' \
        -e 's/^([[:space:]]*shortVersionedName:).*/\1  CraftOS 0.1/' \
        -e 's#^([[:space:]]*(productUrl|supportUrl|donateUrl):).*#\1 https://github.com/nu-stats/craftos#' \
        -e 's#^([[:space:]]*knownIssuesUrl:).*#\1 https://github.com/nu-stats/craftos/issues#' \
        -e 's#^([[:space:]]*releaseNotesUrl:).*#\1 https://github.com/nu-stats/craftos\#readme#' \
        -e 's/^([[:space:]]*sidebarBackground:).*/\1    "#0b1e1b"/' \
        -e 's/^([[:space:]]*sidebarTextSelect:).*/\1    "#78dcb4"/' \
        "${d}branding.desc"
    # Swap the artwork in place (file names stay what branding.desc expects).
    for img in $(sed -n -E 's/^[[:space:]]*(productLogo|productIcon):[[:space:]]*"?([^"]*)"?/\2/p' "${d}branding.desc"); do
        cp /usr/share/craftos/calamares/logo.png "${d}${img}"
    done
    img=$(sed -n -E 's/^[[:space:]]*productWelcome:[[:space:]]*"?([^"]*)"?/\1/p' "${d}branding.desc")
    [ -n "$img" ] && cp /usr/share/craftos/calamares/welcome.png "${d}${img}"
    [ -f "${d}slide1.png" ] && cp /usr/share/craftos/calamares/slide1.png "${d}slide1.png"
    [ -f "${d}show.qml" ] && sed -i 's/Welcome to Debian GNU\/Linux\./Welcome to CraftOS./' "${d}show.qml"
done
for f in /usr/share/applications/*calamares*.desktop /usr/share/applications/*install*debian*.desktop; do
    [ -f "$f" ] || continue
    sed -i -E -e 's/^Name=.*(Debian|Install).*/Name=Install CraftOS/' -e 's/^Icon=.*/Icon=craftos-install/' "$f"
done
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true

# Installed systems: Debian's installer removes the live packages and its own
# settings package from the target but leaves calamares, whose "Install
# System" launcher then sits in the app grid forever. Remove it too.
sed -i "/^ *- 'calamares-settings-debian'\$/a\\      - 'calamares'" /etc/calamares/modules/packages.conf

# Live desktop shortcut: Debian marks it trusted only on Xfce, so GNOME's
# desktop shows a raw "install-debian.desktop" file. Trust it everywhere.
sed -i 's/^if \[ "\$XDG_CURRENT_DESKTOP" = "XFCE" \]; then *$/if true; then/' /usr/bin/add-calamares-desktop-icon

