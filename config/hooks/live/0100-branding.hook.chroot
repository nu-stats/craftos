#!/bin/sh
# Runs inside the image chroot at build time.
set -e

# Keep ID=debian so tools treat us as Debian; change what users see.
if [ -f /etc/os-release ]; then
    sed -i \
        -e 's/^PRETTY_NAME=.*/PRETTY_NAME="CraftOS 0.1 (based on Debian GNU\/Linux 12)"/' \
        -e 's/^NAME=.*/NAME="CraftOS"/' \
        -e 's/^HOME_URL=.*/HOME_URL="https:\/\/github.com\/nu-stats"/' \
        /etc/os-release
    echo 'VARIANT="CraftOS spin"' >> /etc/os-release
fi
echo "CraftOS 0.1" > /etc/craftos-release

# Compile dconf defaults (panel layout, theme, favourites).
dconf update

# Flathub for the software center.
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
