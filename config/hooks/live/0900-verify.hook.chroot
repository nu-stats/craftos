#!/bin/sh
# Fails the build when the image is missing something the spin promises, so a
# green CI run means these are in place (not that lb merely exited 0).
fail=0
chk() {
    if ! eval "$2"; then
        echo "VERIFY FAIL: $1" >&2
        fail=1
    fi
}

chk "dconf database compiled"      '[ -f /etc/dconf/db/craftos ]'
chk "Arc theme installed"          '[ -d /usr/share/themes/Arc ]'
chk "Papirus icons installed"      '[ -d /usr/share/icons/Papirus ]'
chk "os-release says CraftOS"      'grep -q "^NAME=\"CraftOS\"" /usr/lib/os-release'
chk "Plymouth theme is craftos"    '[ "$(plymouth-set-default-theme)" = craftos ]'
chk "craftos-desktop installed"    'dpkg -s craftos-desktop >/dev/null 2>&1'
chk "default wallpaper present"    '[ -f /usr/share/backgrounds/craftos/contours-1921-faint-dark.jpg ]'
chk "wallpaper chooser entry"      '[ -f /usr/share/gnome-background-properties/craftos.xml ]'
chk "live user can be created"     'dpkg -s user-setup >/dev/null 2>&1 && dpkg -s live-config >/dev/null 2>&1'
chk "live-tools installed"         'dpkg -s live-tools >/dev/null 2>&1'
chk "login screen db compiled"     '[ -f /etc/dconf/db/gdm ]'
chk "LibreOffice absent"          '! dpkg -s libreoffice-core >/dev/null 2>&1'
chk "no GNOME games pulled in"     '! dpkg -s gnome-games >/dev/null 2>&1 && ! dpkg -s aisleriot >/dev/null 2>&1'

for app in wordcraft gridcraft deckcraft pdfcraft; do
    chk "$app installed"           "dpkg -s $app >/dev/null 2>&1"
    chk "$app launcher present"    "[ -f /usr/share/applications/ai.storyteller.$app.desktop ]"
done

echo "verify: pinned launchers on disk:"
ls /usr/share/applications | grep -E "storyteller|craft" || true
exit $fail
