#!/bin/sh
# Fails the build when the image is missing something the spin promises, so a
# green CI run means these are in place (not that lb merely exited 0).
fail=0
chk() {
    if ! eval "$2"; then
        echo "VERIFY FAIL: $1" >&2
        fail=1
    fi
}

chk "dconf database compiled"      '[ -f /etc/dconf/db/craftos ] && dpkg -S /etc/dconf/db/craftos.d/00-craftos 2>/dev/null | grep -q craftos-desktop'
chk "Arc theme installed"          '[ -d /usr/share/themes/Arc ]'
chk "Papirus icons installed"      '[ -d /usr/share/icons/Papirus ]'
chk "os-release says CraftOS"    'grep -q "^NAME=\"CraftOS\"" /usr/lib/os-release && grep -q "^ID=debian" /usr/lib/os-release'
chk "os-release survives updates" 'dpkg-divert --list /usr/lib/os-release | grep -q craftos-desktop'
chk "Plymouth theme is craftos"    '[ "$(plymouth-set-default-theme)" = craftos ]'
chk "craftos-desktop installed"    'dpkg -s craftos-desktop >/dev/null 2>&1'
chk "default wallpaper present"    '[ -f /usr/share/backgrounds/craftos/contours-1921-faint-paper.jpg ]'
chk "wallpaper chooser entry"      '[ -f /usr/share/gnome-background-properties/craftos.xml ]'
chk "live user can be created"     'dpkg -s user-setup >/dev/null 2>&1 && dpkg -s live-config >/dev/null 2>&1'
chk "live-tools installed"         'dpkg -s live-tools >/dev/null 2>&1'
chk "login logo is CraftOS"        'grep -q "^logo=.*/usr/share/craftos/login-logo.png" /etc/gdm3/greeter.dconf-defaults'
chk "no Debian account picture"    '[ ! -e /etc/skel/.face ]'
chk "start menu (ArcMenu)"         '[ -d /usr/share/gnome-shell/extensions/arcmenu@arcmenu.com ] && [ -f /usr/share/craftos/start-button.svg ]'
chk "ArcMenu can load (GMenu)"     'ls /usr/lib/*/girepository-1.0/GMenu-3.0.typelib >/dev/null 2>&1'
chk "installer shortcut trusted"    '! grep -q "XFCE\" ]; then" /usr/bin/add-calamares-desktop-icon'
chk "ArtCraft menu group"         '[ -f /etc/xdg/menus/applications-merged/craftos-artcraft.menu ] && [ -f /usr/share/desktop-directories/craftos-artcraft.directory ]'
chk "installer removed after install" 'grep -q "^ *- .calamares.$" /etc/calamares/modules/packages.conf'
chk "workspace cube"              '[ -f /usr/share/gnome-shell/extensions/desktop-cube@schneegans.github.com/metadata.json ]'
chk "wobbly windows"              '[ -f /usr/share/gnome-shell/extensions/compiz-windows-effect@hermes83.github.com/metadata.json ]'
chk "extensions target GNOME 48"  'dpkg-query -W gnome-shell | grep -q "[[:space:]]48."'
chk "liquid glass dock"           '[ -f /usr/share/gnome-shell/extensions/craftos-shell@craftos/glass.js ]'
chk "frosted menus and windows"   '[ -f /usr/share/gnome-shell/extensions/craftos-shell@craftos/menus.js ] && [ -f /usr/share/gnome-shell/extensions/craftos-shell@craftos/windows.js ]'
chk "Frosted Glass settings"      '[ -f /usr/share/glib-2.0/schemas/org.gnome.shell.extensions.craftos-shell.gschema.xml ] && [ -f /usr/share/applications/craftos-frosted-glass.desktop ] && dpkg -s gnome-shell-extension-prefs >/dev/null 2>&1'
chk "light shell theme"           '[ -s /usr/share/gnome-shell/extensions/craftos-shell@craftos/stylesheet.css ] && [ -f /usr/share/backgrounds/craftos/contours-1921-faint-paper.jpg ]'
chk "macOS-style dock"            '[ -d /usr/share/gnome-shell/extensions/dash-to-dock@micxgx.gmail.com ] && [ -f /usr/share/gnome-shell/extensions/craftos-shell@craftos/extension.js ]'
chk "desktop icons (DING)"         '[ -d /usr/share/gnome-shell/extensions/ding@rastersoft.com ]'
chk "frosted glass (Blur My Shell)" '[ -f /usr/share/gnome-shell/extensions/blur-my-shell@aunetx/metadata.json ]'
chk "gnome-menus (folder names)"   'dpkg -s gnome-menus >/dev/null 2>&1'
chk "installer icon present"       '[ -f /usr/share/icons/hicolor/256x256/apps/craftos-install.png ]'
chk "installer launcher uses it"   'grep -qs "^Icon=craftos-install" /usr/share/applications/*calamares*.desktop /usr/share/applications/*install*debian*.desktop'
chk "zenity supports --icon-name"     'grep -q icon-name /usr/bin/zenity'
chk "live installer needs no password" '[ -x /lib/live/config/2000-craftos-installer ]'
chk "live user named CraftOS"      'grep -qs "CraftOS" /etc/live/config.conf.d/craftos.conf'
chk "installer tools present"      'command -v unsquashfs >/dev/null && command -v rsync >/dev/null && command -v mkfs.vfat >/dev/null'
chk "installer password check works" 'ls /var/cache/cracklib/cracklib_dict.pwd* >/dev/null 2>&1'
cal=$(dirname "$(ls /etc/calamares/branding/*/branding.desc /usr/share/calamares/branding/*/branding.desc 2>/dev/null | head -n1)")
chk "installer art is CraftOS"     'cmp -s /usr/share/craftos/calamares/welcome.png "$cal/welcome.png"'
chk "installer text is CraftOS"    '[ -f "$cal/show.qml" ] && ! grep -q "Debian GNU/Linux" "$cal/show.qml"'
chk "no Flatpak or Docker"         '! dpkg -s flatpak >/dev/null 2>&1 && ! command -v docker >/dev/null'
chk "LibreOffice absent"      '! dpkg -s libreoffice-core >/dev/null 2>&1'
chk "no GNOME games pulled in"     '! dpkg -s gnome-games >/dev/null 2>&1 && ! dpkg -s aisleriot >/dev/null 2>&1'

for app in wordcraft gridcraft deckcraft pdfcraft; do
    chk "$app installed"           "dpkg -s $app >/dev/null 2>&1"
    chk "$app launcher present"    "[ -f /usr/share/applications/ai.storyteller.$app.desktop ]"
done

echo "verify: pinned launchers on disk:"
ls /usr/share/applications | grep -E "storyteller|craft" || true
exit $fail
