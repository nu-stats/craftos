#!/bin/sh
set -e

if [ "$1" = configure ]; then
    # Firewall: the CraftOS zone is the default on first install only, so a
    # zone chosen later is kept across upgrades.
    if [ -z "$2" ] && command -v firewall-offline-cmd >/dev/null; then
        firewall-offline-cmd --set-default-zone=CraftOS >/dev/null
        if [ -d /run/systemd/system ] && systemctl -q is-active firewalld; then
            firewall-cmd --reload >/dev/null || true
        fi
    fi

    # Snapshots: set up on the first boot of a Btrfs install (or now, for a
    # running system that is already on Btrfs).
    deb-systemd-helper enable craftos-snapshots-setup.service >/dev/null || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl start --no-block craftos-snapshots-setup.service || true
    fi

    # Systems set up before snapshots-setup turned off Debian's snapshot at
    # every boot still take one; turn it off once on upgrade (versions are
    # 0.1.<build time>, and builds from 0.1.202611031700 on have the fix).
    if [ -n "$2" ] && dpkg --compare-versions "$2" lt 0.1.202611031700 &&
       [ -e /etc/snapper/configs/root ] && [ -d /run/systemd/system ]; then
        systemctl disable --now snapper-boot.timer 2>/dev/null || true
    fi

    # Boot menu background (/etc/default/grub.d/50-craftos.cfg). Only on a
    # system that boots with GRUB; the installer runs update-grub itself.
    if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null; then
        update-grub || true
    fi
fi

exit 0
