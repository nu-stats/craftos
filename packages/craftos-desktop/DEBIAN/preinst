#!/bin/sh
# Take over files that CraftOS replaces from other packages, so their updates
# do not undo the change:
#   /usr/lib/os-release (base-files): Debian point releases would otherwise
#     rename the system back to "Debian". ID=debian and the version fields stay
#     Debian's, so tools still see Debian.
#   ArcMenu's search.js (gnome-shell-extension-arc-menu): patched so search
#     works on GNOME Shell 43.9.
set -e

divert() {
    dpkg-divert --package craftos-desktop --add --rename --divert "$1.debian" "$1"
}

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    divert /usr/lib/os-release
    divert /usr/share/gnome-shell/extensions/arcmenu@arcmenu.com/search.js
fi

exit 0
