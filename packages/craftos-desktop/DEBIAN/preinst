#!/bin/sh
# Take over /usr/lib/os-release from base-files, so Debian point releases do
# not rename the system back to "Debian". ID=debian and the version fields stay
# Debian's, so tools still see Debian.
set -e

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    dpkg-divert --package craftos-desktop --add --rename \
        --divert /usr/lib/os-release.debian /usr/lib/os-release
    # CraftOS on Debian 12 also replaced ArcMenu's search.js; ArcMenu on
    # Debian 13 needs no patch, so hand it back if that diversion is left over.
    arc=/usr/share/gnome-shell/extensions/arcmenu@arcmenu.com/search.js
    if dpkg-divert --list "$arc" | grep -q craftos-desktop; then
        dpkg-divert --package craftos-desktop --remove --rename --divert "$arc.debian" "$arc"
    fi
fi

exit 0
