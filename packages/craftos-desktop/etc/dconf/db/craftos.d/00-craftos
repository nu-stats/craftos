# Light, macOS-style layout (like Zorin's macOS layout): top bar with the CraftOS
# menu at the left, a centered floating dock at the bottom, window buttons on
# the left; workspace cube and wobbly windows. Adwaita light with green
# accent, Papirus icons. The dock lists the nu-stats Craft apps first, then
# Firefox, Files and Software (the ArtCraft apps are in the menu, not the
# dock). Launchers whose app is not installed are ignored by GNOME.
# Dash to Panel stays installed (and configured below) for anyone who prefers
# a Windows-style taskbar; it is just not enabled by default.
[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'craftos-shell@craftos', 'appindicatorsupport@rgcjonas.gmail.com', 'arcmenu@arcmenu.com', 'ding@rastersoft.com', 'blur-my-shell@aunetx', 'desktop-cube@schneegans.github.com', 'compiz-windows-effect@hermes83.github.com']
favorite-apps=['statcraft.desktop', 'rcraft.desktop', 'qualcraft.desktop', 'egocraft.desktop', 'mapcraft.desktop', 'husky-eye-view.desktop', 'mergecraft.desktop', 'husky-explorer.desktop', 'heic-converter.desktop', 'craft-keys.desktop', 'firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop']

# Super opens the CraftOS menu, so the overview (Mission Control) gets the
# macOS-style Ctrl+Up, with Alt so text editors keep Ctrl+Up; it pairs with
# Ctrl+Alt+Left/Right, which turn the workspace cube.
[org/gnome/shell/keybindings]
toggle-overview=['<Control><Alt>Up']

[org/gnome/desktop/interface]
gtk-theme='Adwaita'
color-scheme='prefer-light'
# GNOME 48 native accent, nearest to the CraftOS green.
accent-color='green'
icon-theme='Papirus'
font-name='Inter 10'
clock-show-date=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/craftos/contours-1921-faint-paper.jpg'
picture-uri-dark='file:///usr/share/backgrounds/craftos/contours-1921-faint-dark.jpg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/craftos/contours-1921-faint-paper.jpg'
picture-options='zoom'

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:appmenu'

# Dock: centered at the bottom, floating (not full width), app grid
# ("Launchpad") button first, dots under running apps, frosted by Blur My Shell.
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
extend-height=false
dash-max-icon-size=40
custom-theme-shrink=true
show-show-apps-button=true
show-apps-at-top=true
show-trash=false
show-mounts=false
running-indicator-style='DOTS'
custom-theme-customize-running-dots=true
custom-theme-running-dots-color='#1d1d1f'
custom-theme-running-dots-border-color='#1d1d1f'
click-action='minimize-or-previews'
# Clear dock background: the CraftOS liquid glass (craftos-shell) draws it.
transparency-mode='FIXED'
background-opacity=0.0
disable-overview-on-startup=true

# Frosted glass (Blur My Shell 67, effect pipelines): white frost on the top
# bar, dock and frosted windows for the light Mac-style look; the overview
# keeps the darker default blur.
[org/gnome/shell/extensions/blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000000'>, 'params': <{'radius': <30>, 'brightness': <0.6>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'radius': <30>, 'brightness': <0.6>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <24>}>}>]>}, 'pipeline_craftos_glass': {'name': <'CraftOS glass'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_craftos_000001'>, 'params': <{'radius': <30>, 'brightness': <1.0>}>}>, <{'type': <'color'>, 'id': <'effect_craftos_000002'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.55)>}>}>]>}}

[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
pipeline='pipeline_craftos_glass'
static-blur=true
override-background=true

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
# Off: the dock uses the CraftOS liquid glass instead.
blur=false

[org/gnome/shell/extensions/blur-my-shell/applications]
blur=true
customize=true
sigma=32
brightness=1.0
opacity=204
# Focused windows stay frosted too (true would make the active one opaque).
dynamic-opacity=false
# Frosted Glass on every window (craftos-shell keeps these in step with its
# Settings > Frosted Glass sliders), except where see-through hurts. The
# desktop icons layer (DING) is a full-screen window with class 'gjs'.
enable-all=true
blacklist=['Plank', 'com.desktop.ding', 'com.rastersoft.ding', 'ding', 'gjs', 'Conky', 'mpv', 'vlc', 'org.gnome.Totem', 'org.gnome.Showtime', 'steam', 'Steam', 'gnome-shell']
# Only used if enable-all is turned off. Wayland reports app ids
# (org.gnome.Terminal); X11 apps report class names.
whitelist=['org.gnome.Nautilus', 'Org.gnome.Nautilus', 'org.gnome.Terminal', 'gnome-terminal-server', 'Gnome-terminal']

# Optional Windows-style taskbar (not enabled by default).
[org/gnome/shell/extensions/dash-to-panel]
panel-position='BOTTOM'
panel-size=44
show-appmenu=false
# Land on the desktop at login, not the overview.
hide-overview-on-startup=true
# Start button (ArcMenu) replaces the app-grid and Activities buttons.
panel-element-positions='{"0":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]}'
# Translucent panel; Blur My Shell frosts what shows through.
trans-use-custom-opacity=true
trans-panel-opacity=0.55
dot-style-focused='METRO'
dot-style-unfocused='DOTS'

# CraftOS menu at the top left (where the Apple menu sits), opened with
# Super. Categories show the ArtCraft suite as its own group.
[org/gnome/shell/extensions/arcmenu]
menu-layout='Whisker'
menu-button-icon='Custom_Icon'
custom-menu-button-icon='/usr/share/craftos/start-button.svg'
custom-menu-button-icon-size=20.0
arcmenu-hotkey=['Super_L']
# No "ArcMenu vN released" donation pop-up on first login.
update-notifier-enabled=false
position-in-panel='Left'
# Pinned: the nu-stats Craft apps first, then the basics, like the dock. The
# ArtCraft apps have their own ArtCraft category.
pinned-apps=[{'id': 'statcraft.desktop'}, {'id': 'rcraft.desktop'}, {'id': 'qualcraft.desktop'}, {'id': 'egocraft.desktop'}, {'id': 'mapcraft.desktop'}, {'id': 'husky-eye-view.desktop'}, {'id': 'mergecraft.desktop'}, {'id': 'husky-explorer.desktop'}, {'id': 'heic-converter.desktop'}, {'id': 'craft-keys.desktop'}, {'id': 'firefox-esr.desktop'}, {'id': 'org.gnome.Nautilus.desktop'}, {'id': 'org.gnome.Terminal.desktop'}, {'id': 'org.gnome.Software.desktop'}]

# App grid: the ArtCraft suite in one folder, next to GNOME's Utilities.
[org/gnome/desktop/app-folders]
folder-children=['Utilities', 'ArtCraft']

[org/gnome/desktop/app-folders/folders/ArtCraft]
name='ArtCraft'
apps=['ai.storyteller.wordcraft.desktop', 'ai.storyteller.gridcraft.desktop', 'ai.storyteller.deckcraft.desktop', 'ai.storyteller.pdfcraft.desktop']

# Desktop icons: Home, Trash and drives down the top right, like a Mac.
[org/gnome/shell/extensions/ding]
show-home=true
show-trash=true
show-volumes=true
start-corner='top-right'
icon-size='standard'
# Dark labels: the default wallpaper is light.
dark-text-in-labels=true

# Desktop Cube and wobbly ("jelly") windows: upstream defaults. Switch
# workspaces with Ctrl+Alt+Left/Right (or drag in the overview) to see the cube.
