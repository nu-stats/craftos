<?xml version="1.0" encoding="UTF-8"?>
<!-- CraftOS Frosted Glass (craftos-shell@craftos), in the spirit of
     Pop!_OS COSMIC's Frosted Glass: per-surface switches plus frost
     thickness and glass opacity. Window and top-bar blur are drawn by Blur
     My Shell; craftos-shell keeps its settings in step with these keys. -->
<schemalist>
  <schema id="org.gnome.shell.extensions.craftos-shell" path="/org/gnome/shell/extensions/craftos-shell/">
    <key name="glass-windows" type="b">
      <default>true</default>
      <summary>Frosted glass on application windows</summary>
    </key>
    <key name="glass-panel" type="b">
      <default>true</default>
      <summary>Frosted glass on the top bar</summary>
    </key>
    <key name="glass-dock" type="b">
      <default>true</default>
      <summary>Liquid glass on the dock</summary>
    </key>
    <key name="glass-menus" type="b">
      <default>true</default>
      <summary>Frosted glass on menus and pop-ups</summary>
    </key>
    <key name="frost" type="i">
      <range min="0" max="100"/>
      <default>50</default>
      <summary>Frost thickness (how strongly what is behind is blurred)</summary>
    </key>
    <key name="dock-glass" type="i">
      <range min="0" max="100"/>
      <default>8</default>
      <summary>Dock glass: 0 is clear liquid glass, 100 is frosted white</summary>
    </key>
    <key name="dock-size" type="i">
      <range min="24" max="64"/>
      <default>40</default>
      <summary>Dock icon size in px (Dash to Dock's icon size follows it)</summary>
    </key>
    <key name="dock-magnify" type="i">
      <range min="0" max="150"/>
      <default>75</default>
      <summary>Dock magnification on hover: 0 is off, 100 doubles the icon, 150 makes it 2.5 times</summary>
    </key>
    <key name="opacity" type="i">
      <range min="40" max="100"/>
      <default>80</default>
      <summary>Glass opacity (100 is solid)</summary>
    </key>
  </schema>
</schemalist>
